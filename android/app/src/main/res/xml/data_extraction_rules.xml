<?xml version="1.0" encoding="utf-8"?>
<!--
  HR-8.5: allowBackup="false" is the primary control. This file is the modern
  (API 31+) half of the same rule - it governs cloud backup and device-to-device
  transfer, which allowBackup alone no longer covers.

  Both are set to exclude EVERYTHING. This app holds pairing state and a
  Keystore-backed device identity; a backup that copied it off the device would
  hand an attacker the pairing without ever touching the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
